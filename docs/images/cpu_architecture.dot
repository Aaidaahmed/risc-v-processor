
digraph RV32I {
    graph [
        label="RV32I RISC-V PROCESSOR",
        labelloc=t,
        fontsize=26,
        fontname="Arial Bold",
        fontcolor="#1B2B59",
        rankdir=TB,
        splines=ortho,
        nodesep=0.48,
        ranksep=0.72,
        pad=0.3,
        bgcolor="white",
        compound=true,
        newrank=true
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=11,
        color="#718096",
        fontcolor="#172033",
        penwidth=1.5,
        margin="0.18,0.12"
    ];

    edge [
        fontname="Arial",
        fontsize=9,
        color="#64748B",
        fontcolor="#475569",
        arrowsize=0.7,
        penwidth=1.25
    ];

    subgraph cluster_fetch {
        label="1. INSTRUCTION FETCH";
        color="#82B5FF";
        fontcolor="#2458B5";
        style="rounded,filled";
        fillcolor="#F0F6FF";
        penwidth=1.5;

        PC [label="Program Counter\nPC / next PC",
            fillcolor="#DCEBFF", color="#5798FF"];
        IM [label="Instruction Memory\n(IM)", fillcolor="#DCEBFF",
            color="#5798FF"];

        PC -> IM [label="fetch address"];
    }

    subgraph cluster_decode {
        label="2. DECODE & OPERANDS";
        color="#BFA8FF";
        fontcolor="#7844C7";
        style="rounded,filled";
        fillcolor="#F7F3FF";
        penwidth=1.5;

        DEC [label="Instruction Decoder\nControl signals",
             fillcolor="#EEE5FF", color="#A184FF"];
        RF [label="Register File\nrs1 · rs2 · old rd",
            fillcolor="#EEE5FF", color="#A184FF"];
        IMM [label="Immediate Generator\nSign-extended immediate",
             fillcolor="#EEE5FF", color="#A184FF"];
        OP [label="Operand Selection\nPC / Register / Immediate",
            fillcolor="#DFD4FF", color="#895BFF"];

        DEC -> RF [label="register indices"];
        DEC -> IMM [label="immediate fields"];
        RF -> OP [label="register values"];
        IMM -> OP [label="immediate"];
    }

    subgraph cluster_execute {
        label="3. EXECUTION & CONTROL";
        color="#75EAD8";
        fontcolor="#087F70";
        style="rounded,filled";
        fillcolor="#F0FDFA";
        penwidth=1.5;

        ALU [label="Arithmetic Logic Unit\n(ALU)",
             fillcolor="#D5F8F0", color="#2DD4BF"];
        BU [label="Branch Unit\n(BU)",
            fillcolor="#D5F8F0", color="#2DD4BF"];
        MAC [label="Custom MAC Unit\nrd + (rs1 × rs2)",
             fillcolor="#D5F8F0", color="#2DD4BF"];

        { rank=same; ALU; BU; MAC; }
    }

    subgraph cluster_memory {
        label="4. MEMORY & PERIPHERALS";
        color="#FFC247";
        fontcolor="#A84A00";
        style="rounded,filled";
        fillcolor="#FFFBEB";
        penwidth=1.5;

        DM [label="Data Memory\nByte / Halfword / Word",
            fillcolor="#FFF0C7", color="#FFB000"];
        GPIO [label="Memory-Mapped GPIO\n0x10000000 / 0x10000004",
            fillcolor="#FFF0C7", color="#FFB000"];

        { rank=same; DM; GPIO; }
    }

    subgraph cluster_writeback {
        label="5. WRITE-BACK & MONITORING";
        color="#FF8AC0";
        fontcolor="#B72D69";
        style="rounded,filled";
        fillcolor="#FFF4F9";
        penwidth=1.5;

        WB [label="Write-Back Selection\nALU / Memory / PC+4 / Immediate / MAC",
            fillcolor="#FFE0EE", color="#FF55A5"];
        CSR [label="Performance Counters\nCycle / Instruction / Load / Store / Branch / MAC",
            fillcolor="#FFE0EE", color="#FF55A5"];

        { rank=same; WB; CSR; }
    }

    IM -> DEC [label="instruction"];
    OP -> ALU [label="operands"];
    RF -> BU [label="branch operands"];
    RF -> MAC [label="rs1 · rs2 · old rd"];
    ALU -> DM [label="effective address / store data"];
    ALU -> GPIO [label="MMIO address selection"];
    DM -> WB [label="load data"];
    GPIO -> WB [label="GPIO read data"];
    ALU -> WB [label="ALU result"];
    MAC -> WB [label="MAC result"];
    PC -> WB [label="PC + 4"];
    IMM -> WB [label="upper immediate"];

    WB -> RF [label="register write-back",
              color="#0F9D78", fontcolor="#0F8064",
              constraint=false, minlen=2];

    BU -> PC [label="branch decision",
              style=dashed, color="#D9468C",
              constraint=false, minlen=4];

    DEC -> PC [label="jump control",
               style=dashed, color="#D9468C",
               constraint=false, minlen=4];

    DEC -> CSR [label="instruction events",
                style=dashed, color="#D9468C",
                constraint=false];

    { rank=same; PC; }
}
