digraph CPU {
    graph [
        label="RV32I RISC-V PROCESSOR",
        labelloc=t,
        fontsize=22,
        fontname="Arial Bold",
        fontcolor="#172554",
        bgcolor="white",
        pad=0.3,
        nodesep=0.35,
        ranksep=0.55,
        rankdir=TB,
        splines=polyline,
        newrank=true
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Arial",
        fontsize=11,
        fontcolor="#172033",
        color="#CBD5E1",
        penwidth=1.2,
        margin="0.18,0.12"
    ];

    edge [
        color="#64748B",
        penwidth=1.2,
        arrowsize=0.7,
        fontname="Arial",
        fontsize=9,
        fontcolor="#475569"
    ];

    subgraph cluster_fetch {
        label="1. INSTRUCTION FETCH";
        fontname="Arial Bold";
        fontsize=12;
        fontcolor="#1D4ED8";
        color="#93C5FD";
        style="rounded,filled";
        fillcolor="#EFF6FF";

        PC [label="Program Counter\nPC + 4 / next PC",
            fillcolor="#DBEAFE", color="#60A5FA"];
        IM [label="Instruction Memory\n(IM)",
            fillcolor="#DBEAFE", color="#60A5FA"];

        PC -> IM [label="fetch address"];
    }

    subgraph cluster_decode {
        label="2. DECODE & OPERANDS";
        fontname="Arial Bold";
        fontsize=12;
        fontcolor="#6D28D9";
        color="#C4B5FD";
        style="rounded,filled";
        fillcolor="#F5F3FF";

        DEC [label="Instruction Decoder\n(DEC)",
             fillcolor="#EDE9FE", color="#A78BFA"];
        RF [label="Register File\n(RF: rs1, rs2, rd)",
            fillcolor="#EDE9FE", color="#A78BFA"];
        IMM [label="Immediate Generator\n(IMM_GEN)",
             fillcolor="#EDE9FE", color="#A78BFA"];
        MUX [label="Operand Selection\nPC / Register / Immediate",
             fillcolor="#DDD6FE", color="#8B5CF6"];

        { rank=same; RF; IMM; }
        DEC -> RF [label="register indices"];
        DEC -> IMM [label="immediate fields"];
        RF -> MUX [label="register values"];
        IMM -> MUX [label="immediate"];
    }

    subgraph cluster_execute {
        label="3. EXECUTION & CONTROL";
        fontname="Arial Bold";
        fontsize=12;
        fontcolor="#0F766E";
        color="#99F6E4";
        style="rounded,filled";
        fillcolor="#F0FDFA";

        ALU [label="Arithmetic Logic Unit\n(ALU)",
             fillcolor="#CCFBF1", color="#5EEAD4"];
        BR [label="Branch Unit\n(BU)",
            fillcolor="#CCFBF1", color="#5EEAD4"];
        MAC [label="Custom MAC Unit\n(Multiply-Accumulate)",
             fillcolor="#CCFBF1", color="#5EEAD4"];

        { rank=same; ALU; BR; MAC; }
    }

    subgraph cluster_memory {
        label="4. MEMORY & PERIPHERALS";
        fontname="Arial Bold";
        fontsize=12;
        fontcolor="#92400E";
        color="#FCD34D";
        style="rounded,filled";
        fillcolor="#FFFBEB";

        DM [label="Data Memory\nByte / Halfword / Word",
            fillcolor="#FEF3C7", color="#FBBF24"];
        GPIO [label="Memory-Mapped GPIO\n0x10000000 / 0x10000004",
            fillcolor="#FEF3C7", color="#FBBF24"];

        { rank=same; DM; GPIO; }
    }

    subgraph cluster_writeback {
        label="5. WRITE-BACK & MONITORING";
        fontname="Arial Bold";
        fontsize=12;
        fontcolor="#9D174D";
        color="#F9A8D4";
        style="rounded,filled";
        fillcolor="#FDF2F8";

        WB [label="Write-Back Mux\nALU / Memory / PC+4 / Imm / MAC",
            fillcolor="#FCE7F3", color="#F472B6"];
        CSR [label="Performance Counters\nCycle / Inst / Load / Store / Branch / MAC",
             fillcolor="#FCE7F3", color="#F472B6"];

        { rank=same; WB; CSR; }
    }

    IM -> DEC [label="instruction"];
    MUX -> ALU [label="operands"];
    MUX -> BR [label="branch operands"];
    RF -> MAC [label="MAC operands", constraint=false];

    ALU -> DM [label="address / store data"];
    ALU -> GPIO [label="MMIO access", constraint=false];

    ALU -> WB [label="ALU result"];
    DM -> WB [label="load data"];
    GPIO -> WB [label="read data"];
    MAC -> WB [label="MAC result"];

    WB -> RF [label="write-back", constraint=false];
    BR -> PC [label="next PC", constraint=false];
    PC -> WB [label="PC + 4", constraint=false];
    IMM -> WB [label="upper immediate", constraint=false];

    DEC -> MAC [label="custom operation", style=dashed, constraint=false];
    DEC -> CSR [label="instruction events", style=dashed, color="#BE185D"];
    PC -> CSR [label="clock / reset context", style=dashed, color="#BE185D"];
}
